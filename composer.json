{
    "name": "hypejunction/hypegit",
    "type": "elgg-plugin",
    "description": "GitHub integration for Elgg — display repository stats, commits, and branches on your Elgg site.",
    "homepage": "https://github.com/hypeJunction/Elgg3-hypeGit",
    "keywords": [
        "elgg",
        "plugin",
        "github"
    ],
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Ismayil Khayredinov",
            "email": "ismayil.khayredinov@gmail.com"
        }
    ],
    "extra": {
        "installer-name": "hypegit"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "require": {
        "php": ">=8.3",
        "ext-intl": "*",
        "elgg/elgg": "~7.0.0",
        "composer/installers": "^2.0",
        "knplabs/github-api": "^3.0",
        "php-http/guzzle7-adapter": "^1.0"
    },
    "autoload": {
        "psr-0": {
            "": "classes/"
        }
    }
}
